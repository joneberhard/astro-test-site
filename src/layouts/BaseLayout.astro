---
const { title } = Astro.props;
const pathname = Astro.url.pathname;
const isActive = (href: string) => pathname === href || (href !== "/" && pathname.startsWith(href));
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<style>
			:root {
				font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
				color-scheme: light dark;
			}
			* { box-sizing: border-box; }
			body {
				max-width: 44rem;
				margin: 0 auto;
				padding: 2rem 1.5rem 4rem;
				line-height: 1.6;
			}
			nav {
				display: flex;
				gap: 1.5rem;
				padding-bottom: 1.5rem;
				margin-bottom: 2rem;
				border-bottom: 1px solid #e5e5e5;
				font-weight: 500;
			}
			nav a {
				color: #555;
				text-decoration: none;
			}
			nav a:hover { color: #000; }
			nav a.active { color: #000; border-bottom: 2px solid #000; }
			h1 { font-size: 2.25rem; margin: 0 0 0.5rem; }
			h2 { font-size: 1.4rem; margin-top: 2rem; }
			p { color: #444; }
			ul { padding-left: 1.25rem; }
			a.cta {
				display: inline-block;
				margin-top: 1rem;
				padding: 0.6rem 1.25rem;
				background: #000;
				color: #fff;
				border-radius: 6px;
				text-decoration: none;
			}
			footer {
				margin-top: 4rem;
				padding-top: 1.5rem;
				border-top: 1px solid #e5e5e5;
				color: #888;
				font-size: 0.85rem;
			}
			@media (prefers-color-scheme: dark) {
				body { background: #0b0b0b; color: #eee; }
				nav { border-color: #2a2a2a; }
				nav a { color: #aaa; }
				nav a:hover, nav a.active { color: #fff; }
				nav a.active { border-color: #fff; }
				p { color: #bbb; }
				footer { color: #777; border-color: #2a2a2a; }
				a.cta { background: #fff; color: #000; }
			}
		</style>
	</head>
	<body>
		<nav>
			<a href="/" class:list={[{ active: isActive("/") }]}>Home</a>
			<a href="/about" class:list={[{ active: isActive("/about") }]}>About</a>
			<a href="/services" class:list={[{ active: isActive("/services") }]}>Services</a>
		</nav>
		<main>
			<slot />
		</main>
		<footer>
			Ghost Zero Marketing · built with Astro · deployed on Cloudflare
		</footer>
	</body>
</html>
